<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for gallery image picking -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PetMinder">

        <!-- ===================================================== -->
        <!--                     LAUNCHER (Splash)                 -->
        <!-- ===================================================== -->
        <activity
            android:name=".ui.onboarding.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.PetMinder.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ===================================================== -->
        <!--                     ONBOARDING                        -->
        <!-- ===================================================== -->

        <activity android:name=".ui.onboarding.LoginActivity" />
        <activity android:name=".ui.onboarding.CreateAccountActivity" />
        <activity android:name=".ui.onboarding.PetInfoActivity1" />
        <activity android:name=".ui.onboarding.PetInfoActivity2" />
        <activity android:name=".ui.onboarding.PetInfoSummaryActivity" />

        <!-- ===================================================== -->
        <!--                       HOME SCREENS                    -->
        <!-- ===================================================== -->
        <activity android:name=".ui.home.HomeNoTaskActivity" />
        <activity android:name=".ui.home.HomeDailyTaskActivity" />

        <!-- ===================================================== -->
        <!--                         TASK                          -->
        <!-- ===================================================== -->
        <activity android:name=".ui.task.CreateTaskActivity" />
        <activity android:name=".ui.task.EditTaskActivity" />

        <!-- Task delete confirmation dialog -->
        <activity
            android:name=".ui.task.dialog.DeleteTaskDialog"
            android:exported="false"
            tools:node="merge" />

        <!-- ===================================================== -->
        <!--                    CALENDAR SCREENS                   -->
        <!-- ===================================================== -->
        <activity android:name=".ui.calendar.CalendarScreenActivity" />
        <activity android:name=".ui.calendar.CalendarFilterActivity" />
        <activity android:name=".ui.calendar.CalendarMinimizedActivity" />

        <!-- ===================================================== -->
        <!--                         PETS                          -->
        <!-- ===================================================== -->
        <activity android:name=".ui.pets.PetListActivity" />
        <activity android:name=".ui.pets.PetDetailsActivity" />

        <!-- ===================================================== -->
        <!--                       SETTINGS                        -->
        <!-- ===================================================== -->
        <activity android:name=".ui.settings.SettingsActivity" />
        <activity android:name=".ui.pets.AddPetActivity" />

        <activity android:name=".ui.pets.AddPetActivity" />
        <activity android:name=".ui.pets.PetListActivity" />
        <activity android:name=".ui.pets.PetDetailsActivity" />

        <!-- ===================================================== -->
        <!--                     MAIN ACTIVITY                     -->
        <!-- ===================================================== -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

    </application>
</manifest>
