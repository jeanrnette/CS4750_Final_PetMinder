<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PetTagStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/rounded_tag_background</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Style for base chips: birthday, etc... -->
    <style name="Widget.PetMinder.Chip.Base">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
        <item name="chipBackgroundColor">@color/lemon_chiffon</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/dark_grey</item>
        <item name="rippleColor">@color/sapphire</item>
    </style>

    <!-- Style for pet chips: Icon + Pet_Name -->
    <style name="Widget.PetMinder.Chip.Pet">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>

        <item name="chipIcon">@drawable/ic_pets</item>
        <item name="chipIconSize">18dp</item>
        <item name="chipIconTint">@color/sapphire</item>
        <item name="chipIconVisible">true</item>

        <item name="chipBackgroundColor">@color/dark_grey</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/dark_grey</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="rippleColor">@color/sapphire</item>
    </style>
</resources>
