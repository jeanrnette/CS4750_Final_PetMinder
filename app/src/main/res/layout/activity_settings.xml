<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ================= TOP BLUE HEADER ================= -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@color/sapphire"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/head_profile"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="22sp"/>
    </LinearLayout>

    <!-- ================= MAIN CONTENT SCROLL ================= -->
    <ScrollView
        android:id="@+id/scrollArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/mainContent"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Upload Image -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_frame_circle"
                android:layout_gravity="center"
                android:backgroundTint="@color/grey">

                <!-- Upload Image: Icon + Text -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/uploadIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_upload"/>
                    <TextView
                        android:layout_gravity="center"
                        android:layout_marginTop="4dp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:text="@string/frame_upload_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"/>
                </LinearLayout>
            </FrameLayout>

            <!-- User Info Card (birthday, pets, account, notifs) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/profileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="10dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/light_grey"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Users' name + edit logo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/profile_name"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Kenia"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="24sp"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_edit"/>
                    </LinearLayout>

                    <!-- Users' BIRTHDAY -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/text_birthday"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="20sp"/>
                        <!-- Chip text is empty, this should be handled in code.-->
                        <com.google.android.material.chip.Chip
                            android:id="@+id/inputBirthday"                        style="@style/Widget.PetMinder.Chip.Base"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <!-- Users' PETS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/text_pets"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="20sp"/>

                        <!--
                        No chips "petChipGroup" because this should be handled in code.
                        Beccasue user can have multiple pets.
                        -->
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/petChipGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleLine="false"
                            app:singleSelection="false" />
                    </LinearLayout>

                    <!-- Users' EMAIL/PHONE info-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">
                        <!-- Email/Phone Label -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/prompt_email_phone"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="20sp"/>
                        <!-- Email -->
                        <EditText
                            android:id="@+id/inputEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/edittext_background"
                            android:hint="rover@example.com"
                            android:padding="12dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dark_grey"/>
                    </LinearLayout>

                    <!-- NOTIFICATION Settings -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/text_notifs"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="20sp"/>

                        <!-- Notif: Daily Tasks -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/notif_daily_tasks"
                                android:textSize="18sp"
                                android:textColor="@color/black" />
                            <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_daily_tasks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:trackTint="@color/ash_grey"
                            />
                        </LinearLayout>

                        <!-- Notif: Health Updates -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/notif_health_updates"
                                android:textSize="18sp"
                                android:textColor="@color/black" />
                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_healthUpdates"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:trackTint="@color/ash_grey"
                                />
                        </LinearLayout>

                        <!-- NOTES user input -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/text_notes"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:textSize="20sp"/>
                            <!-- Email -->
                            <EditText
                                android:id="@+id/inputNotes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/edittext_background"
                                android:hint="@string/lorem_ipsum"
                                android:padding="12dp"
                                android:textColor="@color/black"
                                android:textColorHint="@color/dark_grey"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- ================= BOTTOM NAV ================= -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="95dp"
        android:background="@color/sapphire"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HOME icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:src="@drawable/ic_home"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:tint="@color/white"/>
            <TextView
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="12sp"
                android:text="@string/nav_home"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <!-- CALENDAR icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:src="@drawable/ic_calendar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:tint="@color/white"/>
            <TextView
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="12sp"
                android:text="@string/nav_calendar"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <!-- PETS icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:src="@drawable/ic_pets"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:tint="@color/white"/>
            <TextView
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="12sp"
                android:text="@string/nav_pets"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <!-- SETTINGS icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:src="@drawable/ic_settings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:tint="@color/vibrant_coral"/>
            <TextView
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="12sp"
                android:text="@string/nav_settings"
                android:textColor="@color/vibrant_coral"/>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>