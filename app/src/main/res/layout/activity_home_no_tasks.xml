<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_notask"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_notask"
    android:clipToOutline="true"
    tools:context=".feature.home.HomeNoTasksActivity">

    <!-- TOP BLUE BAR -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#3F51B5"
        android:gravity="center">

        <TextView
            android:text="DAILY TASKS"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- MAIN WHITE CONTENT AREA -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_below="@id/top_bar"
        android:layout_above="@id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@android:color/white">

        <!-- DATE -->
        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="October 21"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginBottom="8dp" />

        <!-- WEEK CALENDAR SECTION -->
        <LinearLayout
            android:id="@+id/week_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Sunday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:text="Sun" android:textColor="@android:color/black" android:textSize="13sp"/>
                <TextView android:text="18" android:textColor="@android:color/black" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Monday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:text="Mon" android:textColor="@android:color/black" android:textSize="13sp"/>
                <TextView android:text="19" android:textColor="@android:color/black" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Tuesday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:text="Tue" android:textColor="@android:color/black" android:textSize="13sp"/>
                <TextView android:text="20" android:textColor="@android:color/black" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Wednesday (highlighted) -->
            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="70dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/date_circle_gray"
                android:layout_marginHorizontal="4dp">
                <TextView android:text="Wed" android:textColor="@android:color/black" android:textSize="13sp"/>
                <TextView android:text="21" android:textColor="@android:color/black" android:textStyle="bold" android:textSize="16sp"/>
            </LinearLayout>

            <!-- Thursday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:text="Thu" android:textColor="@android:color/black" android:textSize="13sp"/>
                <TextView android:text="22" android:textColor="@android:color/black" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Friday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:text="Fri" android:textColor="@android:color/black" android:textSize="13sp"/>
                <TextView android:text="23" android:textColor="@android:color/black" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Saturday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:text="Sat" android:textColor="@android:color/black" android:textSize="13sp"/>
                <TextView android:text="24" android:textColor="@android:color/black" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- SCHEDULE LABEL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Today's Schedule:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <!-- EMPTY MESSAGE -->
        <TextView
            android:id="@+id/tv_no_tasks_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:gravity="center"
            android:text="Create a task by pressing the '+' icon below!"
            android:textColor="#666666"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- PLUS BUTTON -->
    <FrameLayout
        android:id="@+id/fab_container"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/bottom_nav"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/plus_circle_gray" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="+"
            android:textColor="@android:color/white"
            android:textSize="42sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:orientation="horizontal"
        android:background="#3F51B5"
        android:gravity="center">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/home_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:src="@drawable/ic_home"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:tint="#FF7C6B" />
            <TextView
                android:text="Home"
                android:textColor="#FF7C6B"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- CALENDAR -->
        <LinearLayout
            android:id="@+id/calendar_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:src="@drawable/ic_calendar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:tint="@android:color/black" />
            <TextView
                android:text="Calendar"
                android:textColor="@android:color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- PETS -->
        <LinearLayout
            android:id="@+id/pets_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:src="@drawable/ic_pets"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:tint="@android:color/black" />
            <TextView
                android:text="Pets"
                android:textColor="@android:color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- SETTINGS -->
        <LinearLayout
            android:id="@+id/settings_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:src="@drawable/ic_settings"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:tint="@android:color/black" />
            <TextView
                android:text="Settings"
                android:textColor="@android:color/black"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>


