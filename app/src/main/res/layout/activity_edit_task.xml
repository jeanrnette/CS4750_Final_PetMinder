<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ============================================================== -->
    <!--                        TOP BLUE HEADER                         -->
    <!-- ============================================================== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@color/sapphire"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:text="EDIT TASK"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>


    <!-- ============================================================== -->
    <!--                     DELETE | CANCEL | SAVE ROW                 -->
    <!-- ============================================================== -->

    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- DELETE -->
        <Button
            android:id="@+id/btnDelete"
            android:layout_width="100dp"
            android:layout_height="44dp"
            android:backgroundTint="#E4E4E4"
            android:text="Delete"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>

        <!-- CANCEL EDIT (CENTER) -->
        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel Edit"
            android:textColor="@color/sapphire"
            android:textSize="16sp"
            android:gravity="center"/>

        <!-- SAVE -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="100dp"
            android:layout_height="44dp"
            android:backgroundTint="#E4E4E4"
            android:text="Save"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>
    </LinearLayout>


    <!-- ============================================================== -->
    <!--                        FORM SCROLL AREA                         -->
    <!-- ============================================================== -->
    <ScrollView
        android:id="@+id/formScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/actionRow"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <!-- NAME -->
            <TextView
                android:text="Name"
                android:textSize="16sp"
                android:textColor="#444444"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:paddingHorizontal="15dp"
                android:background="@drawable/input_field_bg"
                android:hint="Enter Title..."/>


            <!-- DESCRIPTION -->
            <TextView
                android:text="Description"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#444444"
                android:layout_marginTop="25dp"/>

            <EditText
                android:id="@+id/editDescription"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:paddingHorizontal="15dp"
                android:background="@drawable/input_field_bg"
                android:hint="Enter Description..."/>


            <!-- DATE & TIME -->
            <TextView
                android:text="Date & Time"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#444444"
                android:layout_marginTop="25dp"/>

            <EditText
                android:id="@+id/editDate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:paddingHorizontal="15dp"
                android:background="@drawable/input_field_bg"
                android:hint="Complete by Month, ##:##AM"/>


            <!-- COMPLETED BY -->
            <TextView
                android:text="Completed By:"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#444444"
                android:layout_marginTop="25dp"/>

            <Spinner
                android:id="@+id/spinnerCompletedBy"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/input_field_bg"
                android:paddingHorizontal="15dp"/>


            <!-- NOTE -->
            <TextView
                android:text="Note:"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#444444"
                android:layout_marginTop="25dp"/>

            <EditText
                android:id="@+id/editNote"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:paddingHorizontal="15dp"
                android:background="@drawable/input_field_bg"
                android:hint="Some optional note here ..."/>


            <!-- SKIP FOR TODAY BUTTON -->
            <Button
                android:id="@+id/btnSkip"
                android:layout_width="160dp"
                android:layout_height="45dp"
                android:layout_marginTop="40dp"
                android:paddingHorizontal="15dp"
                android:text="SKIP FOR TODAY"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:backgroundTint="#E4E4E4"
                android:layout_gravity="center_horizontal"/>

        </LinearLayout>
    </ScrollView>


    <!-- ============================================================== -->
    <!--                        BOTTOM NAVIGATION                       -->
    <!-- ============================================================== -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="95dp"
        android:background="@color/sapphire"
        android:weightSum="4"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HOME -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_home"
                android:tint="#FF8A65"/>
            <TextView android:text="Home" android:textColor="#FF8A65"/>
        </LinearLayout>

        <!-- CALENDAR -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_calendar"
                android:tint="@android:color/white"/>
            <TextView android:text="Calendar" android:textColor="@android:color/white"/>
        </LinearLayout>

        <!-- PETS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_pets"
                android:tint="@android:color/white"/>
            <TextView android:text="Pets" android:textColor="@android:color/white"/>
        </LinearLayout>

        <!-- SETTINGS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_settings"
                android:tint="@android:color/white"/>
            <TextView android:text="Settings" android:textColor="@android:color/white"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

