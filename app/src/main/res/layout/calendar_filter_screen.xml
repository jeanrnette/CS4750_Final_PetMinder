<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_filter_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ================= TOP BAR ================= -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#4059AD">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CALENDAR"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_centerInParent="true" />

        <ImageView
            android:id="@+id/filterIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_filter_button"
            android:layout_alignParentRight="true"
            android:layout_marginRight="16dp"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- ================= SCROLL AREA ================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar">

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- FILTER TITLE -->
            <TextView
                android:text="FILTERS"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginBottom="16dp" />

            <!-- ======= PETS SECTION ======= -->
            <TextView
                android:text="Pets"
                android:textStyle="bold"
                android:textSize="18sp" />

            <!-- Phineas -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="#F4A026"
                    android:layout_marginRight="12dp"
                    android:layout_marginLeft="4dp" />

                <TextView
                    android:text="Phineas"
                    android:textSize="16sp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />

                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/checkbox_selector"
                    android:checked="true" />
            </LinearLayout>

            <!-- Felicia -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="#F3EEAC"
                    android:layout_marginRight="12dp"
                    android:layout_marginLeft="4dp" />

                <TextView
                    android:text="Felicia"
                    android:textSize="16sp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />

                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/checkbox_selector"
                    android:checked="false" />
            </LinearLayout>

            <!-- Pepe -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="#8EDDC6"
                    android:layout_marginRight="12dp"
                    android:layout_marginLeft="4dp" />

                <TextView
                    android:text="Pepe"
                    android:textSize="16sp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />

                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/checkbox_selector" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D1D1D1"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <!-- ======= IMPORTANCE SECTION ======= -->
            <TextView
                android:text="Importance"
                android:textStyle="bold"
                android:textSize="18sp" />

            <!-- High -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="#E65454"
                        android:layout_marginRight="12dp"
                        android:layout_marginLeft="4dp" />

                    <TextView
                        android:text="High"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:button="@drawable/checkbox_selector" />
                </LinearLayout>

                <TextView
                    android:text="Vet Visit, Medications, Grooming appointment, Health emergencies"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginLeft="32dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Medium -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="#5C8AB6"
                        android:layout_marginRight="12dp"
                        android:layout_marginLeft="4dp" />

                    <TextView
                        android:text="Medium"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:button="@drawable/checkbox_selector" />
                </LinearLayout>

                <TextView
                    android:text="Bath, Replace litter, Buy food"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginLeft="32dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Low -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="#E5E5E5"
                        android:layout_marginRight="12dp"
                        android:layout_marginLeft="4dp" />

                    <TextView
                        android:text="Low"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:button="@drawable/checkbox_selector" />
                </LinearLayout>

                <TextView
                    android:text="Feedings, Walks, Playtime, Brushing, Water refills"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginLeft="32dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D1D1D1"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <!-- ======= RECURRENCE SECTION ======= -->
            <TextView
                android:text="Recurrence"
                android:textStyle="bold"
                android:textSize="18sp" />

            <!-- One-Time -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="#E65454"
                        android:layout_marginRight="12dp"
                        android:layout_marginLeft="4dp" />

                    <TextView
                        android:text="One-Time"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:button="@drawable/checkbox_selector" />
                </LinearLayout>

                <TextView
                    android:text="Last-minute vet schedule, playdate, etc."
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginLeft="32dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Recurring -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="#5C8AB6"
                        android:layout_marginRight="12dp"
                        android:layout_marginLeft="4dp" />

                    <TextView
                        android:text="Recurring"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:button="@drawable/checkbox_selector" />
                </LinearLayout>

                <TextView
                    android:text="Daily feedings, etc."
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginLeft="32dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Spacing before bottom nav -->
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp" />

        </LinearLayout>
    </ScrollView>

    <!-- ================= BOTTOM NAV BAR ================= -->
    <RelativeLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#4059AD"
        android:layout_alignParentBottom="true"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="4"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- NAV ITEMS EXACTLY MATCHING IMAGE 1... -->
            <!-- (same as previous screen for consistency) -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:src="@drawable/ic_home"
                    android:tint="#FF6F61"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />

                <TextView
                    android:text="Home"
                    android:textColor="#FF6F61"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:src="@drawable/ic_calendar"
                    android:tint="#FFFFFF"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />

                <TextView
                    android:text="Calendar"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:src="@drawable/ic_pets"
                    android:tint="#FFFFFF"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />

                <TextView
                    android:text="Pets"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:src="@drawable/ic_settings"
                    android:tint="#FFFFFF"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />

                <TextView
                    android:text="Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
