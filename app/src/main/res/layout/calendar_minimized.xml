<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_minimized_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ================= TOP BAR ================= -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#4059AD">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CALENDAR"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_centerInParent="true" />

        <ImageView
            android:id="@+id/filterIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_filter_button"
            android:layout_alignParentRight="true"
            android:layout_marginRight="16dp"
            android:layout_centerVertical="true" />

    </RelativeLayout>


    <!-- ================= SCROLL AREA ================= -->
    <ScrollView
        android:id="@+id/scrollArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ===== MINIMIZED CALENDAR IMAGE (Image B) ===== -->
            <ImageView
                android:id="@+id/calendarMin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_calendar_min"
                android:layout_marginBottom="12dp" />

            <!-- ===== SELECTED DATE ===== -->
            <TextView
                android:id="@+id/selectedDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thur. Nov. 20"
                android:textSize="20sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp" />

            <!-- ========================================================= -->
            <!-- ======================= TASK LIST ======================= -->
            <!-- ========================================================= -->

            <!-- TASK 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:gravity="top">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="08:00 AM"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:background="#E3E3E3"
                    android:padding="12dp"
                    android:clipToOutline="true">

                    <TextView
                        android:text="Title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="Details about task here ..."
                        android:textColor="#444444"
                        android:layout_marginTop="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="Owner 1"
                        android:background="#D1D1D1"
                        android:textSize="12sp"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"/>

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_more_vert"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentTop="true"/>
                </RelativeLayout>
            </LinearLayout>


            <!-- TASK 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:gravity="top">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="08:30 PM"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:background="#E3E3E3"
                    android:padding="12dp"
                    android:clipToOutline="true">

                    <TextView
                        android:text="Title"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:text="Details about task here ..."
                        android:textColor="#444444"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:text="Owner 1"
                        android:background="#D1D1D1"
                        android:textSize="12sp"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginTop="8dp"/>

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_more_vert"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentTop="true"/>
                </RelativeLayout>
            </LinearLayout>


            <!-- SPACER ABOVE NAV -->
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp" />

        </LinearLayout>
    </ScrollView>


    <!-- ================= FLOATING PLUS BUTTON ================= -->
    <ImageView
        android:id="@+id/addButton"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/ic_orange_button"
        android:adjustViewBounds="true"
        android:layout_alignParentRight="true"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="100dp"
        android:layout_alignParentBottom="true" />


    <!-- ================= BOTTOM NAVIGATION ================= -->
    <RelativeLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#4059AD"
        android:layout_alignParentBottom="true"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="4"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- HOME -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:src="@drawable/ic_home"
                    android:tint="#FF6F61"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />

                <TextView
                    android:text="Home"
                    android:textColor="#FF6F61"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- CALENDAR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:src="@drawable/ic_calendar"
                    android:tint="#FFFFFF"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />

                <TextView
                    android:text="Calendar"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- PETS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:src="@drawable/ic_pets"
                    android:tint="#FFFFFF"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />

                <TextView
                    android:text="Pets"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- SETTINGS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:src="@drawable/ic_settings"
                    android:tint="#FFFFFF"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />

                <TextView
                    android:text="Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
