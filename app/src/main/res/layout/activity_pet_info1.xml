<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="Welcome!"
        android:textStyle="bold"
        android:textSize="24sp"/>

    <TextView
        android:text="Add Pet Information"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText android:hint="Pet Name" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:hint="Species" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:hint="Sex" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:hint="Age" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnNext"
        android:text="Next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/txtSkip"
        android:text="Do Later"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="8dp"/>
</LinearLayout>
