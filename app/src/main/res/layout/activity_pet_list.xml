<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ========================================================= -->
    <!--                       TOP BLUE HEADER                     -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@color/sapphire"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PET MINDER"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />
    </LinearLayout>


    <!-- ========================================================= -->
    <!--                        PET LIST AREA                      -->
    <!-- ========================================================= -->
    <ScrollView
        android:id="@+id/petsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- =================== PHINEAS CARD =================== -->
            <LinearLayout
                android:id="@+id/cardPhineas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/pet_card_bg"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgPhineas"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/img_finny"
                    android:scaleType="centerCrop"
                    android:background="@drawable/pet_image_bg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Type chip -->
                    <TextView
                        android:id="@+id/chipDog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Dog"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:background="@drawable/chip_dog_bg" />

                    <!-- Name -->
                    <TextView
                        android:id="@+id/txtNamePhineas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Phineas"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black" />

                    <!-- Age -->
                    <TextView
                        android:id="@+id/txtAgePhineas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="2 years and 6 months old"
                        android:textSize="14sp"
                        android:textColor="#555555" />
                </LinearLayout>
            </LinearLayout>


            <!-- ==================== FELICIA CARD ================== -->
            <LinearLayout
                android:id="@+id/cardFelicia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/pet_card_bg"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgFelicia"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/img_felicia"
                    android:scaleType="centerCrop"
                    android:background="@drawable/pet_image_bg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/chipCat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Cat"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:background="@drawable/chip_cat_bg" />

                    <TextView
                        android:id="@+id/txtNameFelicia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Felicia"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:id="@+id/txtAgeFelicia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="10 years and 9 months old"
                        android:textSize="14sp"
                        android:textColor="#555555" />
                </LinearLayout>
            </LinearLayout>


            <!-- ===================== PEPE CARD ===================== -->
            <LinearLayout
                android:id="@+id/cardPepe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/pet_card_bg"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgPepe"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/img_pepe"
                    android:scaleType="centerCrop"
                    android:background="@drawable/pet_image_bg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/chipTurtle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Turtle"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:background="@drawable/chip_turtle_bg" />

                    <TextView
                        android:id="@+id/txtNamePepe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="PePe"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:id="@+id/txtAgePepe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="5 years and 3 months old"
                        android:textSize="14sp"
                        android:textColor="#555555" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>


    <!-- ========================================================= -->
    <!--                        BOTTOM NAVIGATION                   -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="95dp"
        android:background="@color/sapphire"
        android:weightSum="4"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HOME (unselected) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_home"
                android:tint="@android:color/white" />
            <TextView
                android:text="Home"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- CALENDAR (unselected) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_calendar"
                android:tint="@android:color/white" />
            <TextView
                android:text="Calendar"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- PETS (selected) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_pets"
                android:tint="#FF8A65" />
            <TextView
                android:text="Pets"
                android:textColor="#FF8A65" />
        </LinearLayout>

        <!-- SETTINGS (unselected) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_settings"
                android:tint="@android:color/white" />
            <TextView
                android:text="Settings"
                android:textColor="@android:color/white" />
        </LinearLayout>

    </LinearLayout>
    <!-- ADD PET BUTTON ABOVE SETTINGS ICON -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddPet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_round_plus"
        android:tint="@android:color/white"
        app:backgroundTint="#FF8A65"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="140dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
